# Build output
**/target/
**/*.o
**/*.obj
**/*.exe
**/a.out
**/main_test
**/*.class
outputs/
*-results.txt

# Compiled Ligra binaries (third_party/temporal_ligra) have no suffix; ignore
# the build products by name so the sources next to them stay tracked.
third_party/temporal_ligra/apps/**/*.out
third_party/temporal_ligra/utils/*.out

# Datasets and generated graph artifacts. These are large (Yahoo alone has
# ~103M vertices) and are rebuilt by the Java runner, so they stay local.
# data/**/README.md and .gitkeep are re-included below to keep the layout.
data/raw/*
data/compressed/*
*.efindex
*.graph
*.obl
*.offsets
*.timestamps
*.properties
graph_lower_bits.bin
graph_upper_bits.bin
timestamp_lower_bits.bin
timestamp_upper_bits.bin

!data/raw/.gitkeep
!data/compressed/.gitkeep
!data/**/README.md

# IDE metadata
.idea/
.settings/
.classpath
.project
*.iml
*.ipr
*.iws

# Operating-system files
.DS_Store
Thumbs.db
*.swp
